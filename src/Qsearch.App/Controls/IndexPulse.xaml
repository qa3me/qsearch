<UserControl x:Class="Qsearch.App.Controls.IndexPulse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:indexing="clr-namespace:Qsearch.Core.Indexing;assembly=Qsearch.Core"
             x:Name="Root"
             MinHeight="28">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="86" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" MinWidth="128">
            <TextBlock Text="{DynamicResource IndexPulse.Title}"
                       FontFamily="Consolas" FontSize="9"
                       Foreground="{DynamicResource Qsearch.AccentBrush}" />
            <TextBlock Margin="0,2,0,0" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Qsearch.MutedText}">
                        <Setter Property="Text" Value="{DynamicResource Freshness.Unavailable}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Snapshot.Freshness, ElementName=Root}" Value="{x:Static indexing:IndexFreshness.Fresh}">
                                <Setter Property="Text" Value="{DynamicResource Freshness.Fresh}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Snapshot.Freshness, ElementName=Root}" Value="{x:Static indexing:IndexFreshness.CatchingUp}">
                                <Setter Property="Text" Value="{DynamicResource Freshness.CatchingUp}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Snapshot.Freshness, ElementName=Root}" Value="{x:Static indexing:IndexFreshness.Stale}">
                                <Setter Property="Text" Value="{DynamicResource Freshness.Stale}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
            <ProgressBar Minimum="0" Maximum="1"
                         Value="{Binding AnimatedProgress, ElementName=Root}"
                         Style="{DynamicResource Qsearch.ProgressBar}" />
        </Grid>

        <StackPanel Grid.Column="2" Margin="0,0,15,0" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Right" FontSize="12">
                <Run Text="{Binding Snapshot.IndexedItems, ElementName=Root, StringFormat={}{0:N0}, Mode=OneWay}" />
                <Run Text="  " /><Run Text="{DynamicResource Status.IndexedLabel}" />
            </TextBlock>
            <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0"
                       Style="{DynamicResource Qsearch.MutedText}">
                <Run Text="{Binding Snapshot.FreshVolumes, ElementName=Root, Mode=OneWay}" />
                <Run Text=" / " /><Run Text="{Binding Snapshot.TotalVolumes, ElementName=Root, Mode=OneWay}" />
                <Run Text="  " /><Run Text="{DynamicResource Status.ScopesReadyLabel}" />
            </TextBlock>
        </StackPanel>

        <Border Grid.Column="3" CornerRadius="7" Background="{DynamicResource Qsearch.PanelBrush}"
                BorderBrush="{DynamicResource Qsearch.LineBrush}" BorderThickness="1"
                ClipToBounds="True" VerticalAlignment="Stretch">
            <Canvas x:Name="PulseCanvas" Height="28" SizeChanged="OnPulseSizeChanged">
                <Polyline x:Name="PulseLine" Stroke="{DynamicResource Qsearch.AccentBrush}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
        </Border>
    </Grid>
</UserControl>
