<UserControl x:Class="Qsearch.App.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Qsearch.Core.Settings;assembly=Qsearch.Core"
             Background="Transparent"
             Foreground="{DynamicResource Qsearch.TextBrush}"
             FontFamily="{DynamicResource Qsearch.FontFamily}">
    <Border Style="{DynamicResource Qsearch.GlassPanel}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Settings.Title}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings.Launch}" Margin="0,4,0,9"
                       Style="{DynamicResource Qsearch.MutedText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{DynamicResource Settings.Full}" Click="OnStartupFullClick" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartupSurface}" Value="{x:Static settings:StartupSurface.Full}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1" Content="{DynamicResource Settings.Compact}" Click="OnStartupCompactClick" Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartupSurface}" Value="{x:Static settings:StartupSurface.Compact}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <TextBlock Text="{DynamicResource Settings.Appearance}" Margin="0,14,0,7"
                       Style="{DynamicResource Qsearch.MutedText}" />
            <UniformGrid Columns="3">
                <Button Content="{DynamicResource Settings.SystemTheme}" Click="OnThemeSystemClick" Margin="0,0,3,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemePreference}" Value="{x:Static settings:AppThemePreference.System}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Settings.DarkTheme}" Click="OnThemeDarkClick" Margin="3,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemePreference}" Value="{x:Static settings:AppThemePreference.Dark}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Settings.LightTheme}" Click="OnThemeLightClick" Margin="3,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemePreference}" Value="{x:Static settings:AppThemePreference.Light}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <TextBlock Text="{DynamicResource Settings.Shortcut}" Margin="0,14,0,7"
                       Style="{DynamicResource Qsearch.MutedText}" />
            <WrapPanel>
                <Button Content="⊞ S" Click="OnHotkeyWindowsSClick" Margin="0,0,5,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Setter Property="Padding" Value="8,5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyChoice}" Value="{x:Static settings:HotkeyChoice.WindowsS}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Ctrl + Alt + Space" Click="OnHotkeyControlAltSpaceClick" Margin="0,0,5,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Setter Property="Padding" Value="8,5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyChoice}" Value="{x:Static settings:HotkeyChoice.ControlAltSpace}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Ctrl + Shift + Space" Click="OnHotkeyControlShiftSpaceClick" Margin="0,0,5,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Setter Property="Padding" Value="8,5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyChoice}" Value="{x:Static settings:HotkeyChoice.ControlShiftSpace}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Alt + Q" Click="OnHotkeyAltQClick" Margin="0,0,5,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Qsearch.GhostButton}">
                            <Setter Property="Padding" Value="8,5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyChoice}" Value="{x:Static settings:HotkeyChoice.AltQ}">
                                    <Setter Property="Background" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Qsearch.OnAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Qsearch.PrimaryFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
            <Border Margin="0,3,0,0" Padding="8,6" CornerRadius="9"
                    Background="{DynamicResource Qsearch.RaisedBrush}"
                    BorderBrush="{DynamicResource Qsearch.LineBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⊞ S" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Settings.HotkeyProcessOnly}" Margin="8,0,0,0"
                               TextWrapping="Wrap" Style="{DynamicResource Qsearch.MutedText}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource Status.HotkeyConflict}" Margin="0,7,0,0"
                       Foreground="{DynamicResource Qsearch.WarningBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHotkeyConflict}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
