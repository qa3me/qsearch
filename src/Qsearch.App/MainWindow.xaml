<Window x:Class="Qsearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Qsearch.App.Controls"
        xmlns:indexing="clr-namespace:Qsearch.Core.Indexing;assembly=Qsearch.Core"
        xmlns:preview="clr-namespace:Qsearch.App.Services"
        xmlns:safety="clr-namespace:Qsearch.Safety.Models;assembly=Qsearch.Safety"
        mc:Ignorable="d"
        Title="Qsearch"
        Width="1220"
        Height="780"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Qsearch.BackgroundBrush}"
        Foreground="{DynamicResource Qsearch.TextBrush}"
        FontFamily="{DynamicResource Qsearch.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="OnWindowSizeChanged">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RevealCommand}" />
    </Window.InputBindings>

    <Grid x:Name="LayoutRoot" Background="{DynamicResource Qsearch.GridBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState" />
                <VisualState x:Name="MediumState" />
                <VisualState x:Name="NarrowState" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:QsearchMark Width="38" Height="38" IsAnimated="{Binding IsBusy}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Qsearch" FontSize="19" Style="{DynamicResource Qsearch.HeadingText}" />
                            <TextBlock Text="QA3 / LOCAL" Margin="9,4,0,0"
                                       Foreground="{DynamicResource Qsearch.AccentBrush}"
                                       FontFamily="Consolas" FontSize="9" />
                        </StackPanel>
                        <TextBlock x:Name="HeaderCopy" Text="{DynamicResource App.LocalOnly}"
                                   Margin="0,2,0,0" Style="{DynamicResource Qsearch.MutedText}" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="OnSettingsClick" Margin="0,0,6,0"
                            ToolTip="{DynamicResource Settings.Title}"
                            Style="{DynamicResource Qsearch.IconButton}">
                        <ContentControl Width="16" Height="16"
                                        Style="{DynamicResource Qsearch.VectorIconHost}"
                                        Template="{DynamicResource Qsearch.SettingsGlyph}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button Click="OnAboutClick" Margin="0,0,6,0"
                            ToolTip="{DynamicResource About.Title}"
                            Style="{DynamicResource Qsearch.IconButton}">
                        <ContentControl Width="16" Height="16"
                                        Style="{DynamicResource Qsearch.VectorIconHost}"
                                        Template="{DynamicResource Qsearch.AboutGlyph}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button x:Name="CompactButton" Content="{DynamicResource Compact.Open}"
                            Click="OnCompactClick" Margin="0,0,6,0"
                            Style="{DynamicResource Qsearch.GhostButton}" />
                    <Button Content="فا" Click="OnPersianClick" Padding="9,7"
                            Style="{DynamicResource Qsearch.GhostButton}" />
                    <Button Content="EN" Click="OnEnglishClick" Padding="9,7" Margin="5,0,0,0"
                            Style="{DynamicResource Qsearch.GhostButton}" />
                    <Button Content="{DynamicResource Scope.AddFolder}" Click="OnAddFolderClick"
                            Margin="7,0,0,0" Style="{DynamicResource Qsearch.PrimaryButton}" />
                </WrapPanel>
            </Grid>

            <Border Grid.Row="1" Style="{DynamicResource Qsearch.SearchBoxBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Width="18" Height="18" Margin="2,0,12,0"
                          VerticalAlignment="Center" Stretch="Uniform"
                          Stroke="{DynamicResource Qsearch.AccentBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22" />
                    <TextBox Grid.Column="1" x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchTextChanged"
                             Style="{DynamicResource Qsearch.SearchTextBox}"
                             AutomationProperties.Name="{DynamicResource Search.Placeholder}" />
                    <TextBlock Grid.Column="2" Text="{Binding HotkeyDisplayText}"
                               Style="{DynamicResource Qsearch.KeyboardHint}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8"
                    Background="{DynamicResource Qsearch.GlassPanelBrush}" BorderBrush="{DynamicResource Qsearch.LineBrush}"
                    BorderThickness="1" CornerRadius="12">
                <controls:IndexPulse Snapshot="{Binding IndexingSnapshot}" />
            </Border>

            <Grid x:Name="ContentGrid" Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightRailColumn" Width="336" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ResultsHost" Grid.Column="0" Margin="0,0,12,0"
                        Style="{DynamicResource Qsearch.GlassPanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Results.Title}"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="10,1,0,0" Style="{DynamicResource Qsearch.MutedText}">
                                    <Run Text="{DynamicResource Status.VisibleLabel}" /><Run Text="  " /><Run Text="{Binding Results.Count, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Results.RootHint}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{DynamicResource Qsearch.MutedText}" />
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.PanningMode="VerticalOnly"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  MouseDoubleClick="OnResultDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource Qsearch.ResultItem}" />
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridViewColumn Width="210">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="{DynamicResource Column.Name}"
                                                                  Tag="Name" Click="OnSortHeaderClick" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{DynamicResource Qsearch.ResultGlyph}"
                                                                    Style="{DynamicResource Qsearch.ResultIconHost}"
                                                                    VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="350">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="{DynamicResource Column.Path}"
                                                                  Tag="Path" Click="OnSortHeaderClick" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullPath}" FlowDirection="LeftToRight"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Qsearch.MutedBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="76">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="{DynamicResource Column.Type}"
                                                                  Tag="Type" Click="OnSortHeaderClick" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource ItemType.File}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource ItemType.Folder}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsApplication}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource ItemType.Application}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="92" DisplayMemberBinding="{Binding Size}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="{DynamicResource Column.Size}"
                                                                  Tag="Size" Click="OnSortHeaderClick" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="132">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="{DynamicResource Column.Modified}"
                                                                  Tag="Modified" Click="OnSortHeaderClick" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastWriteTimeUtc, StringFormat={}{0:g}}"
                                                           Foreground="{DynamicResource Qsearch.MutedBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="RightRail" Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel>
                        <Border x:Name="MachineIndexCallout" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource Qsearch.SignalChipBorderBrush}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Qsearch.GlassPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FirstRun.IsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Permission.Title}"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Permission.Body}" Margin="0,5,0,10"
                                           TextWrapping="Wrap" Style="{DynamicResource Qsearch.MutedText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Permission.Allow}" Click="OnMachineAccessClick"
                                            Style="{DynamicResource Qsearch.PrimaryButton}" Padding="9,6" />
                                    <Button Content="{DynamicResource Permission.Later}" Click="OnFolderOnlyClick"
                                            Margin="6,0,0,0" Style="{DynamicResource Qsearch.GhostButton}" Padding="9,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FileInspector">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Qsearch.GlassPanel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding SelectedResult}"
                                                        ContentTemplate="{DynamicResource Qsearch.ResultGlyph}"
                                                        Style="{DynamicResource Qsearch.ResultIconHost}"
                                                        Width="24" Height="24" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Preview.Title}"
                                                       Foreground="{DynamicResource Qsearch.AccentBrush}"
                                                       FontFamily="Consolas" FontSize="9" />
                                            <TextBlock Text="{Binding SelectedResult.DisplayName}" Margin="0,5,0,0"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SelectedResult.FullPath}" Margin="0,4,0,0"
                                                       FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectedResult.FullPath}"
                                                       Style="{DynamicResource Qsearch.MutedText}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Padding="7,3" CornerRadius="7"
                                                Background="{DynamicResource Qsearch.SignalChipBrush}"
                                                BorderBrush="{DynamicResource Qsearch.SignalChipBorderBrush}" BorderThickness="1">
                                            <TextBlock FontFamily="Consolas" FontSize="9"
                                                       Foreground="{DynamicResource Qsearch.AccentSoftBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource ItemType.File}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedResult.IsFolder}" Value="True">
                                                                <Setter Property="Text" Value="{DynamicResource ItemType.Folder}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedResult.IsApplication}" Value="True">
                                                                <Setter Property="Text" Value="{DynamicResource ItemType.Application}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <ProgressBar Margin="0,12,0,0" IsIndeterminate="True">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Qsearch.ProgressBar}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <Border Margin="0,13,0,0" Height="174" CornerRadius="12"
                                            Background="{DynamicResource Qsearch.WindowOverlayBrush}" BorderBrush="{DynamicResource Qsearch.LineBrush}"
                                            BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding FilePreview.ImagePreview}" Stretch="Uniform" Margin="8">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilePreview.PreviewKind}" Value="{x:Static preview:LocalPreviewKind.Image}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          PanningMode="VerticalOnly" Margin="10">
                                                <TextBlock Text="{Binding FilePreview.TextPreview}" TextWrapping="Wrap"
                                                           FontFamily="Consolas" FontSize="11" LineHeight="17">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FilePreview.PreviewKind}" Value="{x:Static preview:LocalPreviewKind.Text}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ScrollViewer>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilePreview.PreviewKind}" Value="{x:Static preview:LocalPreviewKind.Image}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FilePreview.PreviewKind}" Value="{x:Static preview:LocalPreviewKind.Text}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ContentControl Content="{Binding SelectedResult}"
                                                                ContentTemplate="{DynamicResource Qsearch.ResultGlyph}"
                                                                Style="{DynamicResource Qsearch.ResultIconHost}"
                                                                Width="34" Height="34"
                                                                HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Preview.MetadataOnly}" Margin="0,6,0,0"
                                                           Style="{DynamicResource Qsearch.MutedText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,8,11">
                                            <TextBlock Text="{DynamicResource Preview.Size}" Style="{DynamicResource Qsearch.MetadataLabel}" />
                                            <TextBlock Text="{Binding FilePreview.SizeText}" Style="{DynamicResource Qsearch.MetadataValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,11">
                                            <TextBlock Text="{DynamicResource Preview.Type}" Style="{DynamicResource Qsearch.MetadataLabel}" />
                                            <TextBlock Text="{Binding FilePreview.Extension}" Style="{DynamicResource Qsearch.MetadataValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,8,11">
                                            <TextBlock Text="{DynamicResource Preview.Created}" Style="{DynamicResource Qsearch.MetadataLabel}" />
                                            <TextBlock Text="{Binding FilePreview.CreatedText}" Style="{DynamicResource Qsearch.MetadataValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,11">
                                            <TextBlock Text="{DynamicResource Preview.Modified}" Style="{DynamicResource Qsearch.MetadataLabel}" />
                                            <TextBlock Text="{Binding FilePreview.ModifiedText}" Style="{DynamicResource Qsearch.MetadataValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                            <TextBlock Text="{DynamicResource Preview.Attributes}" Style="{DynamicResource Qsearch.MetadataLabel}" />
                                            <TextBlock Text="{Binding FilePreview.AttributesText}" Style="{DynamicResource Qsearch.MetadataValue}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Padding="11" CornerRadius="11"
                                            Background="{DynamicResource Qsearch.RaisedBrush}"
                                            BorderBrush="{DynamicResource Qsearch.LineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="8"
                                                        Background="{DynamicResource Qsearch.PanelBrush}">
                                                    <Grid>
                                                        <ContentControl Width="16" Height="16"
                                                                        Style="{DynamicResource Qsearch.VectorIconHost}"
                                                                        Template="{DynamicResource Qsearch.ApplicationGlyph}"
                                                                        Foreground="{DynamicResource Qsearch.MutedBrush}" />
                                                        <Image Source="{Binding FileAssociation.HandlerIcon}"
                                                               Width="22" Height="22" Stretch="Uniform"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Preview.OpensWith}"
                                                               Style="{DynamicResource Qsearch.MetadataLabel}" />
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding FileAssociation.HandlerName}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FileAssociation.IsAvailable}" Value="False">
                                                                        <Setter Property="Text" Value="{DynamicResource Preview.NoDefaultApp}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding FilePurpose.Summary}" Margin="0,10,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FilePurpose.Requirement}" Margin="0,5,0,0"
                                                       TextWrapping="Wrap" Style="{DynamicResource Qsearch.MutedText}" />
                                            <TextBlock Text="{Binding FilePurpose.PublisherLabel}" Margin="0,5,0,0"
                                                       TextWrapping="Wrap" Style="{DynamicResource Qsearch.MutedText}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{DynamicResource Actions.Open}" Command="{Binding OpenCommand}"
                                                Margin="0,0,4,0" Style="{DynamicResource Qsearch.PrimaryButton}" />
                                        <Button Grid.Column="1" Content="{DynamicResource Actions.Reveal}" Command="{Binding RevealCommand}"
                                                Margin="4,0,0,0" Style="{DynamicResource Qsearch.GhostButton}" />
                                    </Grid>

                                    <Border x:Name="FileActionStatus" Margin="0,8,0,0" Padding="9,6"
                                            CornerRadius="8" Background="{DynamicResource Qsearch.StatusChipBrush}"
                                            BorderBrush="{DynamicResource Qsearch.StatusChipBorderBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusMessage}" Value="file-action-unavailable">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasPreviewError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Qsearch.MutedText}">
                                                    <Setter Property="Text" Value="{DynamicResource Preview.Unavailable}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusMessage}" Value="file-action-unavailable">
                                                            <Setter Property="Text" Value="{DynamicResource Status.FileActionUnavailable}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Border Margin="0,14,0,0" Padding="11" CornerRadius="11"
                                            Background="{DynamicResource Qsearch.RaisedBrush}" BorderBrush="{DynamicResource Qsearch.LineBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="14" Height="14" Margin="0,0,7,0"
                                                                    Style="{DynamicResource Qsearch.VectorIconHost}"
                                                                    Template="{DynamicResource Qsearch.ReviewGlyph}"
                                                                    Foreground="{DynamicResource Qsearch.AccentBrush}" />
                                                    <TextBlock Text="{DynamicResource Review.Title}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource Qsearch.WarningBrush}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReviewResult.State}" Value="{x:Static safety:ReviewState.NoNotableSignals}">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.State.None}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.State}" Value="{x:Static safety:ReviewState.ReviewSuggested}">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.State.Review}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.State}" Value="{x:Static safety:ReviewState.HighCaution}">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.State.High}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.State}" Value="{x:Static safety:ReviewState.Incomplete}">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.State.Incomplete}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Review.Disclaimer}" Margin="0,5,0,9"
                                                       TextWrapping="Wrap" Style="{DynamicResource Qsearch.MutedText}" />
                                            <ProgressBar IsIndeterminate="True" Margin="0,0,0,9">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Qsearch.ProgressBar}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReviewLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Margin="0,0,0,8"
                                                       Foreground="{DynamicResource Qsearch.WarningBrush}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource Review.Unavailable}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReviewStatusMessage}" Value="review-unavailable">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReviewStatusMessage}" Value="review-cache-unavailable">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Text" Value="{DynamicResource Review.CacheUnavailable}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Margin="0,0,0,9">
                                                <TextBlock Foreground="{DynamicResource Qsearch.WarningBrush}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding ReviewResult.IncompleteReason}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReviewResult.IncompleteReason}" Value="file-changed-during-review">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.Reason.Changed}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.IncompleteReason}" Value="review-time-budget-expired">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.Reason.Time}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.IncompleteReason}" Value="signature-check-timed-out">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.Reason.Signature}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.IncompleteReason}" Value="review-canceled">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.Reason.Canceled}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewResult.IncompleteReason}" Value="required-evidence-unavailable">
                                                                    <Setter Property="Text" Value="{DynamicResource Review.Reason.Evidence}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding ReviewResult.Evidence}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,3,0,0" Padding="8" CornerRadius="8"
                                                                    Background="{DynamicResource Qsearch.PanelBrush}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Guidance}" Margin="0,3,0,0"
                                                                               TextWrapping="Wrap" Style="{DynamicResource Qsearch.MutedText}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Button Content="{DynamicResource Review.Run}" Command="{Binding ReviewCommand}"
                                                    HorizontalAlignment="Left" Style="{DynamicResource Qsearch.SecondaryButton}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:SettingsPanel x:Name="OnboardingSettingsPanel" Margin="0,10,0,0">
                            <controls:SettingsPanel.Style>
                                <Style TargetType="controls:SettingsPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSettingsOnboarding}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SettingsPanel.Style>
                        </controls:SettingsPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
