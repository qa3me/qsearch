            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <DataTemplate x:Key="Qsearch.ResultGlyph">
        <Viewbox Width="16" Height="16" Style="{DynamicResource Qsearch.IconViewbox}">
            <Canvas Height="512">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Width" Value="384" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static viewModels:ResultVisualKind.Folder}">
                                <Setter Property="Width" Value="512" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static viewModels:ResultVisualKind.Application}">
                                <Setter Property="Width" Value="512" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <Path Fill="{DynamicResource Qsearch.AccentBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{DynamicResource Qsearch.Icon.File}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static viewModels:ResultVisualKind.Folder}">
                                    <Setter Property="Data" Value="{DynamicResource Qsearch.Icon.Folder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static viewModels:ResultVisualKind.Application}">
                                    <Setter Property="Data" Value="{DynamicResource Qsearch.Icon.Application}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
