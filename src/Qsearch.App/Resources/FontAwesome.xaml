    <ControlTemplate x:Key="Qsearch.CloseGlyph" TargetType="ContentControl">
        <Viewbox Style="{DynamicResource Qsearch.IconViewbox}">
            <Canvas Width="384" Height="512">
                <Path Data="{DynamicResource Qsearch.Icon.Close}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Qsearch.ExternalLinkGlyph" TargetType="ContentControl">
        <Viewbox Style="{DynamicResource Qsearch.IconViewbox}">
            <Canvas Width="512" Height="512">
                <Path Data="{DynamicResource Qsearch.Icon.ExternalLink}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Qsearch.SettingsGlyph" TargetType="ContentControl">
        <Viewbox Style="{DynamicResource Qsearch.IconViewbox}">
