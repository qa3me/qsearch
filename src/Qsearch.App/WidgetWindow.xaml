<Window x:Class="Qsearch.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Qsearch.App.Controls"
        xmlns:viewModels="clr-namespace:Qsearch.App.ViewModels"
        Title="Qsearch quick search"
        Width="400"
        Height="620"
        MinWidth="400"
        MinHeight="620"
        MaxWidth="400"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Qsearch.BackgroundBrush}"
        Foreground="{DynamicResource Qsearch.TextBrush}"
        FontFamily="{DynamicResource Qsearch.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border x:Name="Surface" Background="{DynamicResource Qsearch.WindowOverlayBrush}"
            BorderBrush="{DynamicResource Qsearch.LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="18">
        <Grid x:Name="LayoutRoot" Background="{DynamicResource Qsearch.GridBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:QsearchMark Width="38" Height="38">
                    <controls:QsearchMark.Style>
                        <Style TargetType="controls:QsearchMark">
                            <Setter Property="IsAnimated" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IndexStartupState}"
                                             Value="{x:Static viewModels:IndexStartupState.Initializing}">
                                    <Setter Property="IsAnimated" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:QsearchMark.Style>
                </controls:QsearchMark>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Qsearch" FontSize="18" Style="{DynamicResource Qsearch.HeadingText}" />
                    <TextBlock Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Qsearch.MutedText}">
                                <Setter Property="Text" Value="{DynamicResource Status.Ready}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndexStartupState}"
                                                 Value="{x:Static viewModels:IndexStartupState.Initializing}">
                                        <Setter Property="Text" Value="{DynamicResource Status.Initializing}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IndexStartupState}"
                                                 Value="{x:Static viewModels:IndexStartupState.Unavailable}">
                                        <Setter Property="Text" Value="{DynamicResource Status.IndexUnavailable}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Click="OnHideClick"
                        Style="{DynamicResource Qsearch.IconButton}"
                        AutomationProperties.Name="{DynamicResource Widget.Close}">
                    <ContentControl Width="14" Height="14"
                                    Style="{DynamicResource Qsearch.VectorIconHost}"
                                    Template="{DynamicResource Qsearch.CloseGlyph}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0"
                    Style="{DynamicResource Qsearch.SearchBoxBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Width="18" Height="18" Margin="2,0,12,0"
                          VerticalAlignment="Center" Stretch="Uniform"
                          Stroke="{DynamicResource Qsearch.AccentBrush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22" />
                    <TextBox Grid.Column="1" x:Name="WidgetSearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchTextChanged"
                             Style="{DynamicResource Qsearch.SearchTextBox}"
                             FontSize="15"
                             AutomationProperties.Name="{DynamicResource Search.Placeholder}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal">
                <Button x:Name="AllFilterButton" Content="{DynamicResource Widget.All}" Tag="All" Click="OnFilterClick"
                        Style="{DynamicResource Qsearch.SecondaryButton}" Padding="12,6" />
                <Button x:Name="FilesFilterButton" Content="{DynamicResource Widget.Files}" Tag="Files" Click="OnFilterClick"
                        Style="{DynamicResource Qsearch.GhostButton}" Padding="12,6" Margin="7,0,0,0" />
                <Button x:Name="FoldersFilterButton" Content="{DynamicResource Widget.Folders}" Tag="Folders" Click="OnFilterClick"
                        Style="{DynamicResource Qsearch.GhostButton}" Padding="12,6" Margin="7,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="2,13,2,8">
                <TextBlock Text="{DynamicResource Widget.Results}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                             Style="{DynamicResource Qsearch.StatusDot}"
                             Fill="{DynamicResource Qsearch.AccentBrush}" />
                    <TextBlock Style="{DynamicResource Qsearch.MutedText}">
                        <Run Text="{DynamicResource Status.IndexedLabel}" /><Run Text=": " /><Run Text="{Binding IndexingSnapshot.IndexedItems, StringFormat={}{0:N0}, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Style="{DynamicResource Qsearch.GlassPanel}" Padding="6">
                <ListBox x:Name="WidgetResults"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="OnResultDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Qsearch.QuickResultItem}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentControl Grid.RowSpan="2" Content="{Binding}"
                                                ContentTemplate="{DynamicResource Qsearch.ResultGlyph}"
                                                Style="{DynamicResource Qsearch.ResultIconHost}"
                                                VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullPath}"
                                           FlowDirection="LeftToRight" Margin="0,3,0,0"
                                           Style="{DynamicResource Qsearch.MutedText}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="{DynamicResource Widget.OpenMain}" Click="OnOpenMainClick"
                        HorizontalAlignment="Left" Style="{DynamicResource Qsearch.PrimaryButton}" />
                <Button Grid.Column="1" Content="{DynamicResource Widget.About}" Click="OnAboutClick"
                        Style="{DynamicResource Qsearch.GhostButton}" />
            </Grid>
        </Grid>
    </Border>
</Window>
