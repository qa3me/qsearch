<Window x:Class="Qsearch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Qsearch.App.Controls"
        Title="{DynamicResource Settings.Title}"
        Width="520"
        Height="565"
        MinWidth="520"
        MinHeight="565"
        MaxWidth="520"
        MaxHeight="565"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Qsearch.BackgroundBrush}"
        Foreground="{DynamicResource Qsearch.TextBrush}"
        FontFamily="{DynamicResource Qsearch.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="LayoutRoot" Background="{DynamicResource Qsearch.GridBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="2,0,2,14">
            <controls:QsearchMark Width="34" Height="34" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Settings.Title}" FontSize="18"
                           Style="{DynamicResource Qsearch.HeadingText}" />
                <TextBlock Text="Qsearch · QA3" Style="{DynamicResource Qsearch.MutedText}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <controls:SettingsPanel />
        </ScrollViewer>

        <Button Grid.Row="2" Content="{DynamicResource About.Close}" Click="OnCloseClick"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                Style="{DynamicResource Qsearch.GhostButton}" />
    </Grid>
</Window>
